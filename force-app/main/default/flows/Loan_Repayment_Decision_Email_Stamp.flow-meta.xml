<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>

    <assignments>
        <name>Stamp_Email</name>
        <label>Stamp Email</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <assignmentItems>
            <assignToReference>$Record.Applicant_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Loan_Application_Number__r.Applicant_Name__r.Personal_Email__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <interviewLabel>Loan Repayment Decision Email Stamp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Loan Repayment Decision Email Stamp</label>
    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Email</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>OR(ISPICKVAL({!$Record.Sstatus__c}, &quot;Verified&quot;), ISPICKVAL({!$Record.Sstatus__c}, &quot;Rejected&quot;))</filterFormula>
        <object>Loan_Repayment_Receipt__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <status>Active</status>
</Flow>
