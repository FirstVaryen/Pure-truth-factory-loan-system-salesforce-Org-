<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Verified_Email</name>
        <label>Send Verified Email</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <actionName>Loan_Repayment_Receipt__c.Notify_Employee_Verified</actionName>
        <actionType>emailAlert</actionType>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <actionCalls>
        <name>Send_Rejected_Email</name>
        <label>Send Rejected Email</label>
        <locationX>250</locationX>
        <locationY>240</locationY>
        <actionName>Loan_Repayment_Receipt__c.Notify_Employee_Repayment_Rejected</actionName>
        <actionType>emailAlert</actionType>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <apiVersion>62.0</apiVersion>

    <decisions>
        <name>Check_Decision_Outcome</name>
        <label>Check Decision Outcome</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Send_Rejected_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Rejected</defaultConnectorLabel>
        <rules>
            <name>Is_Verified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Sstatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Verified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Verified_Email</targetReference>
            </connector>
            <label>Verified</label>
        </rules>
    </decisions>

    <interviewLabel>Loan Repayment Decision Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Loan Repayment Decision Notification</label>
    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Decision_Outcome</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>OR(ISPICKVAL({!$Record.Sstatus__c}, &quot;Verified&quot;), ISPICKVAL({!$Record.Sstatus__c}, &quot;Rejected&quot;))</filterFormula>
        <object>Loan_Repayment_Receipt__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <status>Active</status>
</Flow>
