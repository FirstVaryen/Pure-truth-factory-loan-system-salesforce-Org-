<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_Active_Status</name>
        <label>Check Active Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Existing_Loan</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Active</defaultConnectorLabel>
        <rules>
            <name>Not_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Employee_Account.Active__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Not_Active_Screen</targetReference>
            </connector>
            <label>Not Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Affordability</name>
        <label>Check Affordability</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Loan_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Affordable</defaultConnectorLabel>
        <rules>
            <name>Not_Affordable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loan_Amount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>AffordabilityLimit</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Not_Affordable_Screen</targetReference>
            </connector>
            <label>Not Affordable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Loan_Already_Exists</name>
        <label>Check If Loan Already Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Employee_Salary</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Existing_Loan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Existing_Loan</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Already_Have_Active_Loan</targetReference>
            </connector>
            <label>Has Existing Loan</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>Loan_Reason_Choices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Loan_Reason__c</picklistField>
        <picklistObject>Loan_Application__c</picklistObject>
    </dynamicChoiceSets>
    <formulas>
        <name>AffordabilityLimit</name>
        <dataType>Currency</dataType>
        <expression>({!Get_Employee_Salary.Gross_payment__c} * 0.36 * {!Loan_Duration})</expression>
    </formulas>
    <formulas>
        <name>LoanEndDateCalc</name>
        <dataType>Date</dataType>
        <expression>{!Loan_Start_Date} + ({!Loan_Duration} * 30)</expression>
    </formulas>
    <environments>Default</environments>
    <interviewLabel>Submit Loan Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Submit Loan Application</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Loan_Record</name>
        <label>Create Loan Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Display</targetReference>
        </connector>
        <inputAssignments>
            <field>Applicant_Name__c</field>
            <value>
                <elementReference>Get_Employee_Account.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Loan_Amount__c</field>
            <value>
                <elementReference>Loan_Amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Loan_Reason__c</field>
            <value>
                <elementReference>Loan_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Loan_End_Data__c</field>
            <value>
                <elementReference>LoanEndDateCalc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Loan_Start_Date__c</field>
            <value>
                <elementReference>Loan_Start_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <object>Loan_Application__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Check_Existing_Loan</name>
        <label>Check Existing Loan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Loan_Already_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Applicant_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Employee_Account.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Loan_Application__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Employee_Account</name>
        <label>Get Employee Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Active_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Portal_User__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Employee_Salary</name>
        <label>Get Employee Salary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loan_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Employee_Account.Designation__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Salary_Scale__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Not_Affordable_Screen</name>
        <label>Not Affordable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Not_Affordable_Message</name>
            <fieldText>&lt;p&gt;This loan amount is too high for your salary and repayment period. Go back and try a smaller amount or a longer duration.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Not_Active_Screen</name>
        <label>Not Active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Not_Active_Message</name>
            <fieldText>&lt;p&gt;Only active employees may apply for a loan. Please contact the Finance Department if you believe this is an error.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Already_Have_Active_Loan</name>
        <label>Already Have Active Loan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Already_Have_Loan</name>
            <fieldText>&lt;p&gt;You already have an active loan application. Please wait for it to be resolved before applying again. &lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Display</name>
        <label>Confirmation Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Notification</name>
            <fieldText>&lt;div style=&quot;font-family: -apple-system, Segoe UI, Arial, sans-serif;&quot;&gt;&lt;p style=&quot;font-size:16px;&quot;&gt;Your loan application has been submitted successfully.&lt;/p&gt;&lt;div style=&quot;background:#F4F6FC;border-radius:10px;padding:20px 24px;margin-top:12px;max-width:420px;&quot;&gt;&lt;div style=&quot;display:inline-block;background:#FBF1DD;color:#B8842A;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;padding:5px 12px;border-radius:999px;margin-bottom:14px;&quot;&gt;{!Create_Loan_Record.Status__c}&lt;/div&gt;&lt;p style=&quot;margin:6px 0;&quot;&gt;&lt;strong&gt;Application:&lt;/strong&gt; {!Create_Loan_Record.Name}&lt;/p&gt;&lt;p style=&quot;margin:6px 0;&quot;&gt;&lt;strong&gt;Amount:&lt;/strong&gt; {!Create_Loan_Record.Loan_Amount__c}&lt;/p&gt;&lt;p style=&quot;margin:6px 0;&quot;&gt;&lt;strong&gt;Reason:&lt;/strong&gt; {!Loan_Reason}&lt;/p&gt;&lt;p style=&quot;margin:6px 0;&quot;&gt;&lt;strong&gt;Duration:&lt;/strong&gt; {!Loan_Duration} months&lt;/p&gt;&lt;p style=&quot;margin:6px 0;&quot;&gt;&lt;strong&gt;Start Date:&lt;/strong&gt; {!Loan_Start_Date}&lt;/p&gt;&lt;/div&gt;&lt;p style=&quot;margin-top:14px;color:#5B6285;font-size:13px;&quot;&gt;You&amp;#39;ll receive an email once the Finance Officer reviews your application.&lt;/p&gt;&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Loan_Details</name>
        <label>Loan Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Check_Affordability</targetReference>
        </connector>
        <fields>
            <name>Loan_Amount</name>
            <dataType>Currency</dataType>
            <fieldText>Loan Amount</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Loan_Reason</name>
            <choiceReferences>Loan_Reason_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Loan Reason</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Loan_Duration</name>
            <dataType>Number</dataType>
            <fieldText>Loan Duration</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Loan_Start_Date</name>
            <dataType>Date</dataType>
            <fieldText>Loan Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Employee_Account</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
