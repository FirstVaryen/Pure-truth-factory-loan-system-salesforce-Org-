<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Loan_Application_Submitted</fullName>
        <description>Loan Application Submitted</description>
        <protected>false</protected>
        <recipients>
            <recipient>Loan_Approvers</recipient>
            <type>group</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Loan_Application_Submitted_Notification</template>
    </alerts>
    <alerts>
        <fullName>Notify_Employee_Approved</fullName>
        <description>Notify Employee - Loan Approved</description>
        <protected>false</protected>
        <recipients>
            <field>Applicant_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Loan_Application_Approved</template>
    </alerts>
    <alerts>
        <fullName>Notify_Employee_Rejected</fullName>
        <description>Notify Employee - Loan Rejected</description>
        <protected>false</protected>
        <recipients>
            <field>Applicant_Email__c</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Loan_Application_Rejected</template>
    </alerts>
</Workflow>
